# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# OpenRouter API key: needed for live calls to typesafe/jev-1.13 (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hugging Face token: needed once to download the gated LLM-AggreFact dataset.
# Accept the dataset terms first, using the account that owns this token:
# https://huggingface.co/datasets/lytang/LLM-AggreFact
HF_TOKEN=your_huggingface_token_here

# Optional overrides (defaults shown)
DECISIONS_API_URL=https://openrouter.ai/api/alpha/decisions
DECISIONS_MODEL=typesafe/jev-1.13

# Force offline mock mode for the Jev client even if a key is set (mock scores are NOT evidence)
MOCK_API_MODE=false
