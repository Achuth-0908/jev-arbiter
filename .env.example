# OpenRouter API (Decisions endpoint and models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional candidate/baseline providers
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here

# OpenRouter Decisions endpoint configuration
# Note: Base URL must point directly to openrouter.ai/api/alpha/decisions
DECISIONS_API_URL=https://openrouter.ai/api/alpha/decisions
DECISIONS_MODEL=typesafe/jev-1.13

# Runtime settings
MOCK_API_MODE=false
CACHE_DB_PATH=.cache/calls.db
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT_SECONDS=60
